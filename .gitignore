# Data: never commit datasets (downloaded or derived). Keep the folders via .gitkeep.
# EXCEPTION: data/samples/ IS tracked — sample_headlines.csv is a bundled,
# researcher-authored illustrative sample (not a market dataset).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

